* text=auto eol=crlf

# Workflows must stay LF so GitHub Actions registers them.
.github/workflows/*.yml eol=lf
.github/workflows/*.yaml eol=lf

# Binary files must not be line-ending normalized.
*.bin binary
*.bmp binary
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.a binary
*.elf binary
*.o binary
*.obj binary
*.prx binary
*.self binary
*.sprx binary
